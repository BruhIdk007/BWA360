+/*
+ * OpenXeChain / LLD PowerPC function import thunk finder.
+ *
+ * Current LLD emits:
+ *
+ *   lis   r11, IAT@ha
+ *   lwz   r11, IAT@l(r11)
+ *   mtctr r11
+ *   bctr
+ *
+ * XEX function imports need a type-1 import record located at this
+ * executable stub, in addition to the type-0 IAT record.
+ *
+ * This is intentionally a targeted OpenXeChain bring-up implementation.
+ * It should eventually be replaced with authoritative function/data
+ * import metadata propagated by the linker/toolchain.
+ */
+static uint32_t findImportThunk(FILE *basefile,
+                                struct peData *peData,
+                                uint32_t iatAddr)
+{
+    /*
+     * LLD/OpenXeChain import stub:
+     *
+     *   lis   r11, IAT@ha
+     *   lwz   r11, IAT@l(r11)
+     *   mtctr r11
+     *   bctr
+     *
+     * For M1 bring-up, scan the complete mapped image rather than
+     * depending on section permission metadata.
+     *
+     * The full 16-byte pattern includes the concrete IAT address,
+     * making accidental matches extremely unlikely.
+     */
+
+    if(peData->size < 16)
+    {
+        return 0;
+    }
+
+    uint16_t hi =
+        (uint16_t)(((iatAddr + 0x8000) >> 16) & 0xFFFF);
+
+    uint16_t lo =
+        (uint16_t)(iatAddr & 0xFFFF);
+
+    uint8_t pattern[16] =
+    {
+        /* lis r11, IAT@ha */
+        0x3D, 0x60,
+        (uint8_t)(hi >> 8),
+        (uint8_t)(hi & 0xFF),
+
+        /* lwz r11, IAT@l(r11) */
+        0x81, 0x6B,
+        (uint8_t)(lo >> 8),
+        (uint8_t)(lo & 0xFF),
+
+        /* mtctr r11 */
+        0x7D, 0x69, 0x03, 0xA6,
+
+        /* bctr */
+        0x4E, 0x80, 0x04, 0x20
+    };
+
+    uint8_t *buffer = malloc(peData->size);
+
+    if(!buffer)
+    {
+        return 0;
+    }
+
+    if(fseek(basefile, 0, SEEK_SET) != 0)
+    {
+        nullAndFree((void **)&buffer);
+        return 0;
+    }
+
+    size_t got =
+        fread(buffer,
+              1,
+              peData->size,
+              basefile);
+
+    if(got != peData->size)
+    {
+        fprintf(stderr,
+                "SynthXEX> M1 thunk scan: "
+                "short read (%zu / %u)\n",
+                got,
+                peData->size);
+
+        nullAndFree((void **)&buffer);
+        return 0;
+    }
+
+    for(uint32_t off = 0;
+        off + sizeof(pattern) <= peData->size;
+        off += 4)
+    {
+        if(memcmp(buffer + off,
+                  pattern,
+                  sizeof(pattern)) == 0)
+        {
+            uint32_t thunk =
+                peData->baseAddr + off;
+
+            fprintf(stderr,
+                    "SynthXEX> M1 thunk found: "
+                    "IAT=0x%08X "
+                    "THUNK=0x%08X "
+                    "RVA=0x%08X\n",
+                    iatAddr,
+                    thunk,
+                    off);
+
+            nullAndFree((void **)&buffer);
+
+            return thunk;
+        }
+    }
+
+    fprintf(stderr,
+            "SynthXEX> M1 thunk NOT found: "
+            "IAT=0x%08X "
+            "image-size=0x%08X\n",
+            iatAddr,
+            peData->size);
+
+    nullAndFree((void **)&buffer);
+
+    return 0;
+}
